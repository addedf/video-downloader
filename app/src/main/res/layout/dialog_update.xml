<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_update_dialog"
    android:orientation="vertical"
    android:paddingStart="@dimen/update_dialog_horizontal_padding"
    android:paddingTop="@dimen/update_dialog_top_padding"
    android:paddingEnd="@dimen/update_dialog_horizontal_padding"
    android:paddingBottom="@dimen/update_dialog_bottom_padding">

    <TextView
        android:id="@+id/tvUpdateTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/update_dialog_title"
        android:textColor="@color/update_dialog_title"
        android:textSize="@dimen/update_dialog_title_text_size"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvUpdateVersion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/update_dialog_version_top_margin"
        android:textColor="@color/update_dialog_text"
        android:textSize="@dimen/update_dialog_body_text_size" />

    <TextView
        android:id="@+id/tvUpdateContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/update_dialog_content_top_margin"
        android:lineSpacingExtra="@dimen/update_dialog_content_line_spacing"
        android:textColor="@color/update_dialog_text"
        android:textSize="@dimen/update_dialog_body_text_size" />

    <LinearLayout
        android:id="@+id/updateButtonRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/update_dialog_button_top_margin"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnUpdateLater"
            android:layout_width="0dp"
            android:layout_height="@dimen/update_button_min_height"
            android:layout_weight="1"
            android:background="@drawable/bg_update_secondary_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="@dimen/update_button_min_height"
            android:minWidth="@dimen/update_button_min_width"
            android:paddingStart="@dimen/update_button_horizontal_padding"
            android:paddingEnd="@dimen/update_button_horizontal_padding"
            android:text="@string/update_dialog_button_later"
            android:textColor="@color/update_button_secondary_text"
            android:textSize="@dimen/update_button_text_size"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnUpdateNow"
            android:layout_width="0dp"
            android:layout_height="@dimen/update_button_min_height"
            android:layout_marginStart="@dimen/update_button_gap"
            android:layout_weight="1"
            android:background="@drawable/bg_update_primary_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="@dimen/update_button_min_height"
            android:minWidth="@dimen/update_button_min_width"
            android:paddingStart="@dimen/update_button_horizontal_padding"
            android:paddingEnd="@dimen/update_button_horizontal_padding"
            android:text="@string/update_dialog_button_update"
            android:textColor="@color/white"
            android:textSize="@dimen/update_button_text_size"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
