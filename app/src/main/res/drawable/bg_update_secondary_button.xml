<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/update_button_corner_radius" />
            <solid android:color="@color/update_button_secondary_pressed" />
            <stroke
                android:width="@dimen/update_button_stroke_width"
                android:color="@color/update_button_secondary_stroke" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/update_button_corner_radius" />
            <solid android:color="@color/update_button_secondary" />
            <stroke
                android:width="@dimen/update_button_stroke_width"
                android:color="@color/update_button_secondary_stroke" />
        </shape>
    </item>
</selector>
